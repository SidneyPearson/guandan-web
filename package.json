{
  "name": "guandan-online",
  "version": "1.25.2",
  "private": true,
  "description": "掼蛋单机、同一 Wi-Fi 与公网好友房间",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.cjs",
    "start:lan": "node server/index.cjs --mode=lan",
    "start:public": "node server/index.cjs --mode=public",
    "test:online": "node --test test/online.cjs test/online-client.cjs",
    "test:online-browser": "node test/browser/online.cjs"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "linkedom": "^0.18.15",
    "socket.io-client": "^4.8.1"
  }
}
